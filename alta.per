SCHEMA formonly
layout
grid
{
[lc          ][C   ]
[ld          ]
[DC                                                               ]
[                                                                 ]
[lt          ][t]
[lu          ][CP         ]
}
end --grid
end --layout

ATTRIBUTES
label lc : TEXT=%"alta.cliente";
label ld : TEXT=%"alta.descripcion";
label lt : TEXT=%"alta.tipo";
label lu : TEXT=%"alta.ubicacion";
edit C = formonly.codigo, UPSHIFT;
textedit DC = formonly.descripcion, SCROLLBARS=none;
combobox CP = formonly.codigop, NOT NULL, DEFAULT="ES", INITIALIZER=lib_paises.cargar_paises;
radiogroup t  = FORMONLY.tipo, ORIENTATION=HORIZONTAL,
  items=(("A",%"alta.tipo.antiguo"),("N",%"alta.tipo.nuevo"),("O",%"alta.tipo.obsoleto"));
end
