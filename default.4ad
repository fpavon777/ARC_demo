<?xml version="1.0" encoding="UTF-8"?>
<!-- Default action texts. The text attribute is the fallback; the LStr key is resolved
     in the language of the session through strings/<lang>/arc_demo.str. -->
<ActionDefaultList>
  <ActionDefault name="accept" text="OK">
    <LStr text="action.accept" />
  </ActionDefault>
  <ActionDefault name="cancel" text="Cancel">
    <LStr text="action.cancel" />
  </ActionDefault>
  <ActionDefault name="close" text="Close">
    <LStr text="action.close" />
  </ActionDefault>
  <ActionDefault name="append" text="Append">
    <LStr text="action.append" />
  </ActionDefault>
  <ActionDefault name="insert" text="Insert">
    <LStr text="action.insert" />
  </ActionDefault>
  <ActionDefault name="delete" text="Delete">
    <LStr text="action.delete" />
  </ActionDefault>
  <ActionDefault name="help" text="Help">
    <LStr text="action.help" />
  </ActionDefault>
</ActionDefaultList>
