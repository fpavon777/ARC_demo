}
end --table
end --layout
attributes
a0 = formonly.empr_alb, title=%"albaranes.col.empresa", upshift, width=7, UNMOVABLE;
edit f000 = formonly.nume_alb, title=%"albaranes.col.numero", UNSORTABLE;
combobox s    = formonly.stat_alb, title=%"albaranes.col.stat", UNSIZABLE,
  items=(("A",%"albaranes.stat.alta"),("B",%"albaranes.stat.bloqueado"),("C",%"albaranes.stat.cobrado"));
edit f001 = formonly.clie_alb, title=%"albaranes.col.cliente", UPSHIFT;
edit f002 = formonly.nomb_cli, title=%"albaranes.col.nombre", STRETCH=X;
checkbox d = formonly.tiene	type char, VALUECHECKED="S", VALUEUNCHECKED="N", title=%"albaranes.col.disp", not null, justify=center, UNHIDABLE;
end
instructions
screen record s_consulta(formonly.empr_alb thru formonly.tiene)
