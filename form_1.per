schema formonly
layout
TABLE ( FLIPPED@MEDIUM, FLIPPED@SMALL )
{
[a0|f000     |s|f001      |f002                                |d ]
[a0|f000     |s|f001      |f002                                |d ]
[a0|f000     |s|f001      |f002                                |d ]
